# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/discord-bot

# Environment
NODE_ENV=development

# Keepio Android notifications (optional) - Google Play Developer API
# Service account JSON key with "View app information" access in the Play Console
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=./google-play-service-account.json
KEEPIO_ANDROID_PACKAGE=com.example.keepio
